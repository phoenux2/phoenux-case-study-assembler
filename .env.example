# Supabase (required for Vercel / phone durable data — without these, local JSON mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional service role for migrations / admin scripts only — never expose to the client
# SUPABASE_SERVICE_ROLE_KEY=

# AI pipeline (optional — app works with AI disabled)
# On Vercel phone deploys this is set to false by default.
AI_ENABLED=false
# AI_API_KEY=
# OPENAI_API_KEY=
# KIMI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# AI_MODEL=gpt-4o-mini
# KIMI_MODEL=kimi-k2-0711-preview

# Phase 4 integrations (optional)
# FIGMA_ACCESS_TOKEN=

# Temporary testing switch: bypass Supabase auth and force local mode
# AUTH_BYPASS=true
